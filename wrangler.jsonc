{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nova2",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "f58eb12a-b8f4-4473-a8eb-32318f10d6ed","database_name": "Nova2" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "b8e3113442cb43b2a3c4f428a2d69901" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
